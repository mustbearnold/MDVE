{
  "name": "mdve",
  "version": "1.0.0",
  "private": false,
  "bin": {
    "mdve": "bin/mdve.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "README.md",
    "LICENSE.md",
    "NOTICE.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mustbearnold/MDVE.git"
  },
  "bugs": {
    "url": "https://github.com/mustbearnold/MDVE/issues"
  },
  "homepage": "https://github.com/mustbearnold/MDVE",
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "description": "Mermaid Diagram Visual Editor with an LLM agent that can view and edit the diagram",
  "engines": {
    "node": "^22.11.0 || ^24.11.0"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "PORT=${MDVE_PORT:-8787} tsx watch server/src/index.ts",
    "dev:web": "vite",
    "build:web": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "build": "npm run build:web && npm run build:server",
    "start": "NODE_ENV=production node dist/server/index.js",
    "prepack": "npm run build",
    "test:e2e": "playwright test",
    "test:e2e:installed": "node scripts/run-installed-e2e.mjs",
    "test:performance:installed": "node scripts/run-installed-performance.mjs",
    "test:install:lifecycle": "node scripts/install-lifecycle.mjs",
    "test:reliability": "npm run build:server && node scripts/reliability-soak.mjs",
    "verify:artifact": "node scripts/check-release-artifact.mjs",
    "verify:licenses": "node scripts/check-production-licenses.mjs",
    "test": "tsx --test server/src/api.test.ts server/src/sessions.test.ts server/src/providers/codex.test.ts web/src/components/WorkbenchTabs.test.ts web/src/mermaid/mutate.test.ts web/src/mermaid/corpus.test.ts web/src/state/persistence.test.ts web/src/state/store.persistence.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/language": "^6.11.0",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.8",
    "@playwright/test": "^1.62.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.3",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@vitejs/plugin-react": "^4.4.1",
    "codemirror": "^6.0.1",
    "concurrently": "^9.1.2",
    "mermaid": "^11.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.4",
    "zustand": "^5.0.4"
  }
}
